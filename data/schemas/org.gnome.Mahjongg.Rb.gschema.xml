<schemalist>
  <enum id="org.gnome.Mahjongg.Rb.BackgroundColor">
    <value nick="system" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="4"/>
  </enum>
  <enum id="org.gnome.Mahjongg.Rb.MapRotation">
    <value nick="single" value="0"/>
    <value nick="sequential" value="1"/>
    <value nick="random" value="2"/>
  </enum>

  <schema id="org.gnome.Mahjongg.Rb" path="/org/gnome/Mahjongg/Rb/">
    <key name="tileset" type="s">
      <default>"postmodern"</default>
      <summary>Name of the tile set to use</summary>
    </key>
    <key name="mapset" type="s">
      <default>"Easy"</default>
      <summary>Name of the layout to use</summary>
    </key>
    <key name="map-rotation" enum="org.gnome.Mahjongg.Rb.MapRotation">
      <default>"single"</default>
      <summary>How the layout advances between games</summary>
    </key>
    <key name="background-color" enum="org.gnome.Mahjongg.Rb.BackgroundColor">
      <default>"system"</default>
      <summary>Colour scheme of the window background</summary>
    </key>
    <key name="window-width" type="i">
      <default>960</default>
      <summary>Width of the window in pixels</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Height of the window in pixels</summary>
    </key>
    <key name="window-is-maximized" type="b">
      <default>false</default>
      <summary>true if the window is maximized</summary>
    </key>
  </schema>
</schemalist>
